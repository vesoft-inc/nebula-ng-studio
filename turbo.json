{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {},
    "lint:types": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "nebula-studio#dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": true
    },
    "nebula-studio#build": {
      "dependsOn": [],
      "cache": false,
      "env": ["STUDIO_BRAND_*", "STUDIO_DEFAULT_LANGUAGE", "STUDIO_VERSION"],
      "outputs": ["dist/**"]
    },
    "@vesoft-inc/ui-components#dev": {
      "dependsOn": [],
      "persistent": true
    },
    "nebula-gui#dev": {
      "dependsOn": [],
      "persistent": true
    },
    "nebula-gui#build": {
      "dependsOn": [],
      "cache": false,
      "env": ["STUDIO_BRAND_*", "STUDIO_DEFAULT_LANGUAGE"],
      "outputs": ["dist/**"]
    },
    "@vesoft-inc/utils#build": {
      "outputs": ["types/**"]
    }
  }
}
