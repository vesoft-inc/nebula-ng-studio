{
  "name": "nebula-studio",
  "version": "5.3.1",
  "description": "nebula-graph-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development vite",
    "build": "NODE_ENV=production tsc && NODE_ENV=production vite build && pnpm copy:server",
    "copy:server": "node -e \"const fs=require('node:fs');if(!fs.existsSync('dist/index.html'))throw new Error('Studio dist is missing');fs.rmSync('../server/assets/public',{recursive:true,force:true});fs.cpSync('dist','../server/assets/public',{recursive:true})\"",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
    "lint:types": "tsc -b --noEmit"
  },
  "dependencies": {
    "@antv/graphlib": "^2.0.3",
    "@antv/layout": "1.2.14-beta.8",
    "@antv/layout-gpu": "^1.1.7",
    "@emotion/css": "^11.13.4",
    "@emotion/is-prop-valid": "^1.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.2.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "7.1.1",
    "@mui/lab": "7.0.0-beta.13",
    "@mui/material": "^7.1.1",
    "@mui/x-date-pickers": "^7.17.0",
    "@vesoft-inc/force-graph": "workspace:*",
    "@vesoft-inc/icons": "^2.3.0",
    "@vesoft-inc/ui-components": "workspace:*",
    "@vesoft-inc/utils": "workspace:*",
    "@xyflow/react": "^12.6.4",
    "bezier-js": "^6.1.4",
    "bignumber.js": "^9.1.2",
    "copy-to-clipboard": "^3.3.3",
    "d3-force-3d": "^3.0.5",
    "d3-force": "^3.0.0",
    "dagre": "^0.8.5",
    "dayjs": "^1.11.10",
    "dom-to-image": "^2.6.0",
    "i18next": "^23.7.19",
    "json-bigint": "^1.0.0",
    "lodash": "^4.17.21",
    "material-react-table": "^2.13.3",
    "material-ui-popup-state": "^5.3.1",
    "mobx": "^6.12.0",
    "mobx-react-lite": "^4.0.5",
    "monaco-editor": "^0.52.2",
    "randomcolor": "^0.6.2",
    "react": "^19.0.0",
    "react-color": "^2.19.3",
    "react-dom": "^19.0.0",
    "react-hook-form": "7.55.0",
    "react-hook-form-mui": "^7.6.1",
    "react-i18next": "^14.0.5",
    "react-router-dom": "6.28.1",
    "react-syntax-highlighter": "^15.6.1",
    "react-transition-group": "^4.4.5",
    "react-window": "^1.8.10",
    "uuid": "^8.3.2",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/bezier-js": "^4.1.3",
    "@types/d3-force": "^3.0.10",
    "@types/dagre": "^0.7.52",
    "@types/dom-to-image": "^2.6.7",
    "@types/json-bigint": "^1.0.4",
    "@types/lodash": "^4.17.10",
    "@types/node": "^20.11.6",
