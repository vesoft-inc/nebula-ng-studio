{
  "name": "@vesoft-inc/force-graph",
  "version": "2.0.16",
  "private": true,
  "type": "module",
  "description": "2D force-directed graph rendered on HTML5 canvas",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "build": "node --check src/index.js && node --check src/force-graph.js && node --check src/canvas-force-graph.js",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasturiano/force-graph.git"
  },
  "homepage": "https://github.com/vasturiano/force-graph",
  "keywords": [
    "2d",
    "force",
    "simulation",
    "graph",
    "canvas",
    "d3"
  ],
  "author": {
    "name": "Vasco Asturiano",
    "url": "http://bl.ocks.org/vasturiano"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vasturiano/force-graph/issues"
  },
  "dependencies": {
    "@tweenjs/tween.js": "18",
    "accessor-fn": "1",
    "bezier-js": "3 - 6",
    "d3-array": "1 - 3",
    "d3-drag": "2 - 3",
    "d3-force-3d": "3",
    "d3-scale": "1 - 4",
    "d3-scale-chromatic": "1 - 3",
    "d3-selection": "2 - 3",
    "d3-zoom": "2 - 3",
    "index-array-by": "1",
    "kapsule": "^1.13",
    "lodash.throttle": "4"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "vitest": "^2.1.9"
  }
}
